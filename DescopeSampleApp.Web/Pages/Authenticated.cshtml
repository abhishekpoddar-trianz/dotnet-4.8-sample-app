@page
@model DescopeSampleApp.Web.Pages.AuthenticatedModel
@{
    ViewData["Title"] = "Authenticated";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Descope Sample App</title>
    <script src="https://unpkg.com/@@descope/web-js-sdk@1.10.45/dist/index.umd.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-5">
        <h1>Welcome to the Authenticated Page!</h1>
        <p>You are successfully logged in.</p>
        <button class="btn btn-primary" onclick="testSampleAPI(event)">Click here to test Sample API</button>

        <div id="apiResponse" class="mt-4"></div>
    </div>

    <script>
        const sdk = Descope({ projectId: "P2dI0leWLEC45BDmfxeOCSSOWiCt", persistTokens: true, autoRefresh: true });

        const sessionToken = sdk.getSessionToken();
        const currentPath = window.location.pathname;

        if (sessionToken && !sdk.isJwtExpired(sessionToken)) {
            // User is logged in
            console.log('User is authenticated');
        } else {
            if (currentPath !== '/Login') {
                // Redirect to login page
                window.location.replace('/Login');
            }
        }

        async function testSampleAPI(event) {
            event.preventDefault();
            const sessionToken = sdk.getSessionToken();

            if (sessionToken && !sdk.isJwtExpired(sessionToken)) {
                try {
                    const response = await fetch("/api/sample", {
                        headers: {
                            "Authorization": `Bearer ${sessionToken}`
                        }
                    });

                    if (!response.ok) {
                        throw new Error(`Request failed with status ${response.status}`);
                    }

                    const responseData = await response.json();
                    console.log(responseData);
                    document.getElementById("apiResponse").innerHTML = `<div class="alert alert-success"><p><strong>Status Code:</strong> ${response.status}</p><pre>${JSON.stringify(responseData, null, 2)}</pre></div>`;
                } catch (error) {
                    console.error("Request failed:", error.message);
                    document.getElementById("apiResponse").innerHTML = `<div class="alert alert-danger"><p><strong>Error:</strong> ${error.message}</p></div>`;
                }
            } else {
                window.location.replace('/Login');
            }
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
