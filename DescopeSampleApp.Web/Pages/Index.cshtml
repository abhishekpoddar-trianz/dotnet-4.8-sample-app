@page
@model DescopeSampleApp.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Descope Sample App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-5">
        <h1>Welcome to Descope Sample App</h1>
        <p>This is the home page of the migrated .NET 8 application.</p>
        <div class="mt-4">
            <a href="/Login" class="btn btn-primary">Login</a>
            <a href="/Authenticated" class="btn btn-success">Authenticated Page</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
