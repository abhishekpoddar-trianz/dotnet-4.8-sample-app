@page
@model DescopeSampleApp.Web.Pages.AuthenticatedPageModel
@{
    ViewData["Title"] = "Authenticated Page";
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"]</title>
    <script src="https://unpkg.com/@@descope/web-js-sdk@@1.10.45/dist/index.umd.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <h1>Welcome to the Authenticated Page!</h1>
        <p>You are successfully authenticated.</p>
        <button class="btn btn-primary" onclick="testSampleAPI(event)">Click here to test Sample API</button>
        <div id="apiResponse" class="mt-3"></div>
    </div>

    <script>
        const sdk = Descope({ projectId: '@Model.ProjectId', persistTokens: true, autoRefresh: true });

        const sessionToken = sdk.getSessionToken();
        const currentPath = window.location.pathname;

        if ((sessionToken) && (!sdk.isJwtExpired(sessionToken))) {
            // User is logged in
            console.log('User is authenticated');
        } else {
            if (currentPath !== '/Login') {
                // Redirect to login page
                window.location.replace('/Login');
            }
        }

        async function testSampleAPI(event) {
            event.preventDefault();
            const sessionToken = sdk.getSessionToken();
            if (sessionToken && !sdk.isJwtExpired(sessionToken)) {
                try {
                    const response = await fetch("/api/sample", {
                        headers: {
                            "Authorization": `Bearer ${sessionToken}`
                        }
                    });

                    if (!response.ok) {
                        throw new Error(`Request failed with status ${response.status}`);
                    }

                    const responseData = await response.json();
                    console.log(responseData);
                    document.getElementById("apiResponse").innerHTML = `<div class="alert alert-success"><p>Status Code: ${response.status}</p><pre>${JSON.stringify(responseData, null, 2)}</pre></div>`;
                } catch (error) {
                    console.error("Request failed:", error.message);
                    document.getElementById("apiResponse").innerHTML = `<div class="alert alert-danger"><p>Error: ${error.message}</p></div>`;
                }
            } else {
                window.location.replace('/Login');
            }
        }
    </script>
</body>
</html>
